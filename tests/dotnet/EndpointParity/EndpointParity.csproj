<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NetworkMonitorLibRoot Condition="'$(NetworkMonitorLibRoot)' == ''">$(MSBuildThisFileDirectory)../../../../NetworkMonitorLib</NetworkMonitorLibRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NetworkMonitorLibRoot)/NetworkMonitor.csproj" />
  </ItemGroup>
</Project>
